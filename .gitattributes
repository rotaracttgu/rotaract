* text=auto eol=lf

# Source code files - always use LF
*.php text eol=lf diff=php
*.blade.php text eol=lf diff=html
*.js text eol=lf diff=javascript
*.css text eol=lf diff=css
*.scss text eol=lf diff=css
*.html text eol=lf diff=html
*.json text eol=lf
*.md text eol=lf diff=markdown
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.env text eol=lf
*.env.* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.font binary

# Export ignore
/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
